---
import BaseLayout from './BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  event: CollectionEntry<'events'>;
}

const { event } = Astro.props;
const { title, releaseDate, characters, cgs, theme } = event.data;
---

<BaseLayout title={`${title} — Terra CG Viewer`} skipHref="#gallery" skipLabel="Skip to gallery">
  <main
    class="relative mx-auto max-w-6xl px-6 py-10"
    style={`--accent: ${theme.accent}; --accent-alt: ${theme.accentAlt};`}
  >
    <div class="pointer-events-none fixed top-20 right-4 bottom-4 left-4 z-10" aria-hidden="true">
      <div class="absolute top-0 left-0 h-6 w-6 border-t-2 border-l-2 border-(--accent)" />
      <div class="absolute top-0 right-0 h-6 w-6 border-t-2 border-r-2 border-(--accent)" />
      <div class="absolute bottom-0 left-0 h-6 w-6 border-b-2 border-l-2 border-(--accent)" />
      <div class="absolute bottom-0 right-0 h-6 w-6 border-b-2 border-r-2 border-(--accent)" />
    </div>

    <header class="mb-8 border-b border-(--text-secondary)/40 pb-6">
      <div class="flex items-center gap-3">
        <a
          href="/events"
          aria-label="Back to all events"
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-sm border border-(--text-secondary)/40 text-(--text-muted) transition-colors hover:border-(--accent) hover:text-(--accent-text) focus-visible:outline-2 focus-visible:outline-(--accent-text) focus-visible:outline-offset-2"
        >
          <span aria-hidden="true">←</span>
        </a>
        <a
          href="/events"
          class="font-mono text-xs uppercase tracking-wide text-(--text-muted) hover:text-(--accent-text) focus-visible:outline-2 focus-visible:outline-(--accent-text) focus-visible:outline-offset-2"
        >
          All Events
        </a>
      </div>
      <p class="mt-4 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.3em] text-(--accent-text)">
        <span class="inline-block h-1.5 w-1.5 rotate-45 bg-(--accent-alt)" aria-hidden="true" />
        Event Archive
      </p>
      <h1
        transition:name={`event-title-${event.id}`}
        class="mt-2 font-display text-4xl font-bold tracking-tight text-(--text-primary) md:text-5xl"
      >
        {title}
      </h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-(--text-muted)">
        <span>{releaseDate.toISOString().slice(0, 10)}</span>
        <span aria-hidden="true">·</span>
        <span>{characters.join(' / ')}</span>
      </div>
      <div class="mt-4 h-px w-full bg-(--text-secondary)/30" aria-hidden="true">
        <div class="h-full w-1/3 bg-(--accent)" />
      </div>
    </header>

    <section id="gallery" aria-labelledby="gallery-heading">
      <p id="gallery-heading" class="mb-4 font-mono text-xs uppercase tracking-widest text-(--accent-text)">
        02 / 02 — GALLERY
      </p>
      <Gallery cgs={cgs} />
    </section>
  </main>
</BaseLayout>
