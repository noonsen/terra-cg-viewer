---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-(--text-secondary)/30">
  <div class="mx-auto max-w-6xl px-6 py-8">
    <p class="font-mono text-xs text-(--text-muted)">
      <a
        href="/"
        class="rounded-sm hover:text-(--accent-text) focus-visible:outline-2 focus-visible:outline-(--accent-text) focus-visible:outline-offset-2"
      >
        Home
      </a>
      <span aria-hidden="true"> | </span>
      <a
        href="/events"
        class="rounded-sm hover:text-(--accent-text) focus-visible:outline-2 focus-visible:outline-(--accent-text) focus-visible:outline-offset-2"
      >
        Events
      </a>
      <span aria-hidden="true"> | </span>
      <a
        href="https://astro.build"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-sm hover:text-(--accent-text) focus-visible:outline-2 focus-visible:outline-(--accent-text) focus-visible:outline-offset-2"
      >
        Built with Astro
      </a>
    </p>
    <p class="mt-3 max-w-2xl font-body text-xs text-(--text-secondary)">
      This is a fan-made project for learning and showcase purposes only, and is not affiliated
      with or endorsed by Hypergryph Co., Ltd. Arknights and all related assets are the property
      of their respective owners.
    </p>
    <p class="mt-2 font-mono text-[10px] text-(--text-secondary)">© {year} Terra CG Viewer</p>
  </div>
</footer>
