---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface EpisodeGroup {
  code: string | null;
  title: string | null;
  anchorId: string;
  bgMix: number;
  coverImage?: string | ImageMetadata;
}

interface Props {
  episodes: EpisodeGroup[];
}

const { episodes } = Astro.props;
---

{
  episodes.some((e) => e.code) && (
    <div class="mb-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
      {episodes.map((ep) => (
        <a
          href={`#${ep.anchorId}`}
          class="group relative block overflow-hidden rounded-sm border border-(--text-secondary)/30 transition-colors hover:border-(--accent) focus-visible:outline-2 focus-visible:outline-(--accent-text) focus-visible:outline-offset-2"
        >
          {ep.coverImage && typeof ep.coverImage !== 'string' ? (
            <Image
              src={ep.coverImage}
              alt=""
              loading="lazy"
              width={320}
              format="webp"
              quality={60}
              class="aspect-[4/5] w-full object-cover"
            />
          ) : (
            <div
              aria-hidden="true"
              class="aspect-[4/5] w-full"
              style={`background: linear-gradient(160deg, color-mix(in srgb, var(--accent) ${ep.bgMix}%, var(--bg)), var(--bg));`}
            />
          )}
          <div class="absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-(--bg)/90 via-(--bg)/10 to-transparent p-2">
            {ep.title && (
              <p class="font-display text-sm font-bold leading-tight text-(--text-primary)">
                {ep.title}
              </p>
            )}
          </div>
          {ep.code && (
            <span class="absolute right-1.5 bottom-1.5 rounded-sm bg-(--bg)/80 px-1.5 py-0.5 font-mono text-[10px] font-bold tracking-wide text-(--accent-text)">
              {ep.code}
            </span>
          )}
        </a>
      ))}
    </div>
  )
}
