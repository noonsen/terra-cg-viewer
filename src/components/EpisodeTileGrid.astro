---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface EpisodeGroup {
  code: string | null;
  title: string | null;
  anchorId: string;
  bgMix: number;
  coverImage?: string | ImageMetadata;
  featured?: boolean;
}

interface Props {
  episodes: EpisodeGroup[];
}

const { episodes } = Astro.props;

// "EP 07" -> { label: "EP", number: "07" }; falls back to the raw code for
// anything that doesn't match the "LABEL NN" shape.
function splitCode(code: string | null) {
  const match = code?.match(/^(\D*?)\s*(\d+)$/);
  if (!match) return { label: code, number: null };
  return { label: match[1] || 'EP', number: match[2] };
}
---

{
  episodes.some((e) => e.code) && (
    <ul class="mb-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-5">
      {episodes.map((ep, i) => {
        const { label, number } = splitCode(ep.code);
        return (
          <li
            class="tile-in"
            style={`animation-delay: ${Math.min(i, 10) * 40}ms;`}
          >
            <a
              href={`#${ep.anchorId}`}
              class="episode-tile group relative block overflow-hidden border border-(--text-secondary)/25 bg-(--bg) transition-[border-color,box-shadow,transform] duration-200 hover:-translate-y-0.5 active:scale-[0.97] hover:border-(--accent) hover:shadow-[0_8px_24px_-8px_var(--accent)] focus-visible:outline-2 focus-visible:outline-(--accent-text) focus-visible:outline-offset-2"
            >
              <span
                class="pointer-events-none absolute inset-x-0 top-0 z-10 h-0.5 scale-x-0 bg-(--accent-alt) transition-transform duration-200 origin-left group-hover:scale-x-100"
                aria-hidden="true"
              />

              <div class="aspect-[4/5] w-full overflow-hidden">
                {ep.coverImage && typeof ep.coverImage !== 'string' ? (
                  <Image
                    src={ep.coverImage}
                    alt=""
                    loading="lazy"
                    width={320}
                    format="webp"
                    quality={60}
                    class="h-full w-full scale-105 object-cover object-top brightness-90 transition-[filter,transform] duration-300 group-hover:scale-110 group-hover:brightness-100"
                  />
                ) : (
                  <div
                    aria-hidden="true"
                    class="h-full w-full"
                    style={`background: linear-gradient(160deg, color-mix(in srgb, var(--accent) ${ep.bgMix}%, var(--bg)), var(--bg));`}
                  />
                )}
              </div>

              <div
                class="pointer-events-none absolute inset-0"
                style="background: linear-gradient(to top, color-mix(in srgb, var(--bg) 92%, transparent) 0%, color-mix(in srgb, var(--bg) 55%, transparent) 30%, transparent 60%);"
                aria-hidden="true"
              />

              <span
                class="absolute top-1.5 left-1.5 z-10 font-mono text-[10px] font-bold tabular-nums text-(--text-muted) opacity-80"
                aria-hidden="true"
              >
                {String(i).padStart(2, '0')}
              </span>

              {ep.featured && (
                <span
                  class="absolute top-1.5 right-1.5 z-10 h-2.5 w-2.5 rotate-45 bg-(--accent-alt) shadow-[0_0_6px_var(--accent-alt)]"
                  aria-hidden="true"
                  title="Featured illustration"
                />
              )}

              <div class="absolute inset-x-0 bottom-0 z-10 flex items-end justify-between gap-1 p-2">
                {ep.title ? (
                  <p class="font-display text-xs leading-tight font-bold text-(--text-primary) sm:text-sm">
                    {ep.title}
                  </p>
                ) : (
                  <span />
                )}

                {number && (
                  <span class="flex shrink-0 flex-col items-center bg-(--accent-alt) px-1.5 py-0.5 leading-none text-(--bg) [clip-path:polygon(15%_0,100%_0,100%_100%,0_100%)]">
                    <span class="font-mono text-[8px] font-bold tracking-widest">{label}</span>
                    <span class="font-mono text-xs font-bold">{number}</span>
                  </span>
                )}
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  )
}

<style>
  .episode-tile {
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%);
  }
</style>
