---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Terra CG Viewer">
  <main class="mx-auto flex min-h-[70vh] max-w-3xl flex-col justify-center px-6 py-16">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-(--accent-text)">
      Fan Project — Non-Commercial
    </p>
    <h1 class="mt-2 font-display text-6xl font-bold tracking-tight">Terra CG Viewer</h1>
    <p class="mt-4 max-w-xl font-body text-base text-(--text-muted)">
      A showcase of Arknights event story CG art, organized by event. Not affiliated with
      Hypergryph.
    </p>

    <a
      href="/events"
      class="mt-8 inline-flex w-fit items-center gap-2 rounded-sm border border-(--accent-alt) bg-(--accent-alt) px-6 py-3 font-mono text-sm font-bold uppercase tracking-wide text-(--bg) transition-colors hover:bg-(--accent) hover:border-(--accent) focus-visible:outline-2 focus-visible:outline-(--accent-text) focus-visible:outline-offset-2"
    >
      Browse Events →
    </a>
  </main>
</BaseLayout>
